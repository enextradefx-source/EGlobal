# Copy this file to .env and fill in your links.
# Only VITE_-prefixed variables are exposed to the browser.

# Footer social links
VITE_SOCIAL_TELEGRAM=https://t.me/yourchannel
VITE_SOCIAL_TIKTOK=https://www.tiktok.com/@yourusername
VITE_SOCIAL_INSTAGRAM=https://instagram.com/yourpage
VITE_SOCIAL_FACEBOOK=https://facebook.com/yourpage
VITE_SOCIAL_TWITTER=https://x.com/yourhandle
VITE_SOCIAL_YOUTUBE=https://youtube.com/@yourchannel

# Hero background image (downloaded from Pinterest)
VITE_HERO_IMAGE=/images/hero-bg.png

# Forex chart background (landscape) — available for future sections.
VITE_FOREX_IMAGE=/images/pin-forex-background.png

# Get Started / signup link (used by Navbar, Hero, Mentorship, Course, CTA band)
# Leave empty to scroll to the final CTA section, or set to your signup URL.
VITE_GET_STARTED_LINK=

# Log In link (Navbar). Leave empty to use the built-in #/login page,
# or set to your real dashboard/login URL when it goes live.
VITE_LOGIN_LINK=

# Sign up link. Leave empty to use the built-in #/signup page,
# or set to your real signup URL when it goes live.
VITE_SIGNUP_LINK=

# Paystack public key (starts with pk_). Get it from
# https://dashboard.paystack.com/#/settings/developers
# NOTE: never put your SECRET key (sk_) in frontend code.
VITE_PAYSTACK_PUBLIC_KEY=

# Admin panel (demo). These live in the browser bundle on purpose for now —
# when a real backend is added, admin auth must move server-side.
VITE_ADMIN_EMAIL=admin@enex.global
VITE_ADMIN_PASSWORD=enex-admin

# Legal / contact links (Footer). Set when your pages go live.
VITE_TERMS_LINK=
VITE_PRIVACY_LINK=
VITE_CONTACT_LINK=

# Facilitator personal links (team section)
# Prefix = VITE_TEAM_<FIRSTNAME>_<SOCIAL>
VITE_TEAM_SIMON_TELEGRAM=
VITE_TEAM_SIMON_TIKTOK=
VITE_TEAM_SIMON_INSTAGRAM=
VITE_TEAM_SIMON_FACEBOOK=
VITE_TEAM_SIMON_TWITTER=
VITE_TEAM_GLORIA_TELEGRAM=
VITE_TEAM_GLORIA_TIKTOK=
VITE_TEAM_GLORIA_INSTAGRAM=
VITE_TEAM_GLORIA_FACEBOOK=
VITE_TEAM_GLORIA_TWITTER=
VITE_TEAM_SONIA_TELEGRAM=
VITE_TEAM_SONIA_TIKTOK=
VITE_TEAM_SONIA_INSTAGRAM=
VITE_TEAM_SONIA_FACEBOOK=
VITE_TEAM_SONIA_TWITTER=
VITE_TEAM_DANIEL_TELEGRAM=
VITE_TEAM_DANIEL_TIKTOK=
VITE_TEAM_DANIEL_INSTAGRAM=
VITE_TEAM_DANIEL_FACEBOOK=
VITE_TEAM_DANIEL_TWITTER=
